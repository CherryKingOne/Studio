# ========== 应用 ==========
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=60181
# 宿主机映射端口（Docker Compose 使用）
API_PORT_HOST=60181
LOG_LEVEL=info
LOG_FORMAT=pretty

# ========== 管理员（仅首次启动 users 为空时创建）==========
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
# 管理员登录邮箱（登录使用邮箱+密码）
ADMIN_EMAIL=admin@localhost

# ========== MySQL ==========
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=novelcast
MYSQL_USER=novelcast
MYSQL_PASSWORD=novelcast
# 宿主机映射端口
MYSQL_PORT_HOST=13306
# 本地 cargo run 使用 127.0.0.1；Docker Compose 会覆盖为 mysql:3306
DATABASE_URL=mysql://novelcast:novelcast@127.0.0.1:13306/novelcast
DB_MAX_CONNECTIONS=10

# ========== JWT（双 Token：access + refresh）==========
JWT_SECRET=dev-only-secret-change-me-please-0123456789abcdef
# access_token 有效期（小时），短期令牌
JWT_TTL_HOURS=2
# refresh_token 有效期（天），长期令牌，用于静默续期
JWT_REFRESH_TTL_DAYS=30

# ========== 邮件（注册 / 找回密码验证码）==========
# SMTP_HOST 留空时进入开发模式：验证码不真正发信，仅输出到服务端日志，
# 且 APP_ENV=development 时发送验证码接口会额外返回 dev_code 字段便于调试。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=NovelCast <noreply@novelcast.local>
# TLS 模式：tls（隐式 TLS，常见 465）/ starttls（常见 587）/ none（明文，仅内网测试）
SMTP_TLS=tls

# ========== RustFS（S3 兼容）==========
RUSTFS_ENDPOINT=http://127.0.0.1:19000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=novelcast
# 宿主机映射端口
RUSTFS_PORT_HOST=19000
RUSTFS_CONSOLE_PORT_HOST=19001

# ========== TTS（OpenAI / MiniMax / 阶跃星辰）==========
TTS_DEFAULT_PROVIDER=openai
TTS_DEFAULT_NARRATOR_VOICE_ID=alloy
TTS_OPENAI_API_KEY=
TTS_OPENAI_BASE_URL=https://api.openai.com/v1
TTS_OPENAI_MODEL=gpt-4o-mini-tts
TTS_MINIMAX_API_KEY=
TTS_MINIMAX_GROUP_ID=
TTS_MINIMAX_BASE_URL=https://api.minimaxi.com
TTS_MINIMAX_MODEL=speech-2.8-turbo
TTS_STEPFUN_API_KEY=
TTS_STEPFUN_BASE_URL=https://api.stepfun.com/v1
TTS_STEPFUN_MODEL=step-tts-mini
TTS_MAX_ATTEMPTS=3
TTS_TIMEOUT_SECS=45
TTS_CONCURRENCY=4
TTS_PROVIDER_MIN_INTERVAL_MS=250

# ========== Worker ==========
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_SECS=10
WORKER_STALE_SECS=90

# ========== 音频 ==========
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_CONCURRENCY=2
AUDIO_TMP_DIR=/tmp/novelcast

# ========== 限制 ==========
MAX_IMPORT_BYTES=52428800
MAX_IMAGE_BYTES=5242880
IMPORT_MAX_CHARS=300

# ========== 回收站 ==========
# 保留天数：0-3650；0 表示永久保留并关闭自动清理
# 自动清理由 Worker 每小时执行一次
RECYCLE_BIN_RETENTION_DAYS=30

# ========== CORS（逗号分隔；* 仅开发环境）==========
CORS_ALLOWED_ORIGINS=*
